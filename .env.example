MONGODB_URI=mongodb://127.0.0.1:27017/workabroadhub
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NODE_ENV=development
APP_URL=http://localhost:4000
# Set to true ONLY while testing CSP changes: the browser then reports instead of blocking.
# CSP_REPORT_ONLY=true
# Email (optional: without these, emails are printed in the server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="Work Abroad Hub <you@gmail.com>"
# Google sign-in (optional: without these the Google buttons stay hidden)
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application),
# Authorized JavaScript origin: http://localhost:4000. Paste ONLY the values, no labels.
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret-here

# Logging (optional): fatal | error | warn | info (default) | debug | trace
# debug also shows every static file and health-check request.
# LOG_LEVEL=info

# ---- optional extras (empty = switched off) ----
# National Tax Service business-status lookup (data.go.kr: 국세청_사업자등록정보 진위확인 및 상태조회, "Decoding" key)
NTS_API_KEY=
# SMS codes for student phones (Solapi / CoolSMS). SMS_FROM = your registered sender number, digits only.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=
# Development only: print SMS codes in the console instead of sending (turns the phone step on locally)
# SMS_DEV_CONSOLE=true
# Slack or Discord webhook: gets a message when the server logs an error
ALERT_WEBHOOK_URL=
# Minimum wage override in won/hour (normally taken from the yearly table in src/utils/pay.js)
# MIN_WAGE=
# Minify .js/.css in memory (default: on in production, off in development)
# MINIFY_ASSETS=true

# Backups (scripts/backup.js, GitHub Actions secret of the same name): long random passphrase that encrypts the backup files
# BACKUP_PASSPHRASE=
